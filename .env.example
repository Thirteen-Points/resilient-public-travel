# ============================================================
# ResilientRoute Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# Do NOT commit .env to version control.
# All secrets, API keys, and passwords go here.
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- LLM Configuration (optional, system works without it) ---
# When LLM_ENABLED=false, the system uses deterministic rule-based fallback.
# AI is never on the critical path - route queries work without LLM.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Fallback LLM providers (used in order if primary fails)
LLM_FALLBACK_1_PROVIDER=qwen
LLM_FALLBACK_1_API_KEY=
LLM_FALLBACK_1_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_1_MODEL=qwen-turbo

LLM_FALLBACK_2_PROVIDER=glm
LLM_FALLBACK_2_API_KEY=
LLM_FALLBACK_2_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_FALLBACK_2_MODEL=glm-4-flash

# LLM cost budget (CNY)
LLM_BUDGET_CNY=50.0

# --- External Data Sources (all free, no auth required) ---
# Hong Kong Observatory weather API
HKO_WEATHER_API=https://data.weather.gov.hk/weatherAPI/opendata/weather.php

# MTR real-time schedule API
MTR_SCHEDULE_API=https://rt.data.gov.hk/v1/transport/mtr/getSchedule.php

# KMB open data API
KMB_API_BASE=https://data.etabus.gov.hk/v1/transport/kmb

# data.gov.hk base
DATA_GOV_HK_BASE=https://data.gov.hk

# --- Map / Tile Configuration ---
# Basemap degradation chain: CARTO -> OpenFreeMap -> OSM
MAP_TILE_PROVIDER_1=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_PROVIDER_2=https://tiles.openfreemap.org/osm/{z}/{x}/{y}.png
MAP_TILE_PROVIDER_3=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Database ---
# SQLite file path (relative to project root)
DB_PATH=backend/app/data/resilient.db

# --- Data Directories ---
DATA_DIR=data
GRAPH_SNAPSHOT_DIR=backend/app/data/snapshots
SIM_RESULT_DIR=data/sim
CACHE_DIR=backend/app/data/cache

# --- Offline Mode ---
# When OFFLINE_MODE=true, system uses only local data files.
# No external API calls are made. Health check reports offline status.
OFFLINE_MODE=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=backend/app/data/app.log

# --- Deployment ---
# Used by health check to report deployment info
DEPLOY_ENV=local
DEPLOY_VERSION=1.0.0-dev
