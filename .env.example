# ============================================================
# ResilientRoute Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# Do NOT commit .env to version control.
# All secrets, API keys, and passwords go here.
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
# Comma-separated exact browser origins. Replace the Pages URL if the site changes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://resilient-public-travel.pages.dev

# --- LLM / AI structurer (optional, system works without it) ---
# AI_ENABLED=true turns on LLM event structuring; any ONE provider key suffices.
# Without a key the deterministic rule extractor is used and the demo still runs.
AI_ENABLED=false
# Providers are tried in this order (OpenAI-compatible endpoints):
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# --- Review console authentication ---
# Required for GET /api/events, POST /api/events/{id}/review and the SSE stream.
# In the controlled local demo, enter a temporary credential in Review.
# Never use VITE_REVIEW_TOKEN: Vite variables are exposed in the browser bundle.
REVIEW_API_TOKEN=
# Legacy CORS_ORIGINS is also accepted when CORS_ALLOWED_ORIGINS is unset.

# --- Shared model budget (CNY; persisted across restarts) ---
AI_BUDGET_CNY=50.0
AI_MAX_OUTPUT_TOKENS=2048
AI_CACHE_TTL_S=900
# Conservative official peak CNY rates per million tokens (verified 2026-10-02).
DEEPSEEK_INPUT_COST_PER_MILLION=2
DEEPSEEK_CACHE_HIT_COST_PER_MILLION=0.04
DEEPSEEK_OUTPUT_COST_PER_MILLION=8
# Unknown/custom provider calls retain this estimate unless explicit rates are set.
AI_UNKNOWN_REQUEST_RESERVE_CNY=1
# --no-llm sets true, overriding saved administrator AI settings.
AI_DISABLE_EXTERNAL=false

# --- External Data Sources (all free, no auth required) ---
# Hong Kong Observatory weather API
HKO_WEATHER_API=https://data.weather.gov.hk/weatherAPI/opendata/weather.php

# MTR real-time schedule API
MTR_SCHEDULE_API=https://rt.data.gov.hk/v1/transport/mtr/getSchedule.php

# KMB open data API
KMB_API_BASE=https://data.etabus.gov.hk/v1/transport/kmb

# data.gov.hk base
DATA_GOV_HK_BASE=https://data.gov.hk

# --- Map / Tile Configuration ---
# Basemap degradation chain: CARTO -> OpenFreeMap -> OSM
MAP_TILE_PROVIDER_1=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_PROVIDER_2=https://tiles.openfreemap.org/osm/{z}/{x}/{y}.png
MAP_TILE_PROVIDER_3=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Database ---
# SQLite file path (relative to project root)
DB_PATH=backend/app/data/events.sqlite3

# --- Data Directories ---
DATA_DIR=data
GRAPH_SNAPSHOT_DIR=backend/app/data/snapshots
SIM_RESULT_DIR=data/sim
CACHE_DIR=backend/app/data/cache

# --- Offline Mode ---
# When OFFLINE_MODE=true, system uses only local data files.
# No external API calls are made. Health check reports offline status.
OFFLINE_MODE=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=backend/app/data/app.log

# --- Deployment ---
# Used by health check to report deployment info
DEPLOY_ENV=local
DEPLOY_VERSION=1.0.0-dev

# --- Administrator console (keep server-side; never VITE_* values) ---
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_ENCRYPTION_KEY=
# Set false only for local HTTP development; production cookies stay Secure.
ADMIN_COOKIE_SECURE=true
