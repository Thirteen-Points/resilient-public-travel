{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilient-public-travel.local/contracts/sim.schema.json",
  "title": "ResilientRoute simulation seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "meta", "assumptions", "population", "time_range", "time_step_min", "baseline", "guided", "delta", "fairness", "hero_message", "provenance"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "built_at", "status", "placeholder", "scenario_id", "provenance", "event_ref", "policy_definition"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "built_at": {"type": "string", "format": "date"},
        "status": {"type": "string", "minLength": 1},
        "placeholder": {"type": "boolean"},
        "scenario_id": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["real", "real-derived", "simulated"]},
        "event_ref": {"type": "string", "minLength": 1},
        "policy_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selfish", "bucket"],
          "properties": {
            "selfish": {"type": "string", "minLength": 1},
            "bucket": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "population": {"type": "integer", "minimum": 1},
    "time_range": {"type": "array", "prefixItems": [{"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}], "minItems": 2, "maxItems": 2},
    "time_step_min": {"type": "number", "exclusiveMinimum": 0},
    "baseline": {
      "allOf": [
        {"$ref": "#/$defs/strategyResult"},
        {
          "type": "object",
          "required": ["route_load"],
          "properties": {"route_load": {"type": "array", "items": {"$ref": "#/$defs/routeLoad"}}}
        }
      ]
    },
    "guided": {
      "allOf": [
        {"$ref": "#/$defs/strategyResult"},
        {
          "type": "object",
          "required": ["unstoppable_demand", "shares", "advice"],
          "properties": {
            "unstoppable_demand": {"type": "integer", "minimum": 0},
            "shares": {"type": "array", "items": {"$ref": "#/$defs/routeShare"}},
            "advice": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delay_reduction_pct", "p95_wait_reduction_pct", "served_rate_gain_pp", "overloaded_routes_delta"],
      "properties": {
        "delay_reduction_pct": {"type": "number"},
        "p95_wait_reduction_pct": {"type": "number"},
        "served_rate_gain_pp": {"type": "number"},
        "overloaded_routes_delta": {"type": "integer"}
      }
    },
    "fairness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_extra_delay_min", "protected_users", "note"],
      "properties": {
        "max_extra_delay_min": {"type": "number", "minimum": 0},
        "protected_users": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "hero_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {"enum": ["real", "real-derived", "simulated"]}
  },
  "$defs": {
    "strategyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "total_delay_person_min", "avg_delay_min", "p95_wait_min", "overloaded_routes", "served_rate", "wheelchair_served_rate"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "total_delay_person_min": {"type": "number", "minimum": 0},
        "avg_delay_min": {"type": "number", "minimum": 0},
        "p95_wait_min": {"type": "number", "minimum": 0},
        "overloaded_routes": {"type": "integer", "minimum": 0},
        "served_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "wheelchair_served_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "route_load": {"type": "array", "items": {"$ref": "#/$defs/routeLoad"}},
        "unstoppable_demand": {"type": "integer", "minimum": 0},
        "shares": {"type": "array", "items": {"$ref": "#/$defs/routeShare"}},
        "advice": {"type": "array", "items": {"type": "string"}}
      }
    },
    "routeLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "users", "capacity_per_hour", "load_factor", "overloaded"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "users": {"type": "integer", "minimum": 0},
        "capacity_per_hour": {"type": "number", "minimum": 0},
        "load_factor": {"type": "number", "minimum": 0},
        "overloaded": {"type": "boolean"}
      }
    },
    "routeShare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "share", "users", "capacity_per_hour", "load_factor"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "share": {"type": "number", "minimum": 0, "maximum": 1},
        "users": {"type": "integer", "minimum": 0},
        "capacity_per_hour": {"type": "number", "minimum": 0},
        "load_factor": {"type": "number", "minimum": 0}
      }
    }
  }
}
