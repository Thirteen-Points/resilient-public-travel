{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilient-public-travel.local/contracts/network.schema.json",
  "title": "ResilientRoute network seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "nodes", "lines", "walk_links"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "built_at", "corridor", "catchment_m", "note", "counts"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "built_at": {"type": "string", "format": "date"},
        "corridor": {"type": "string", "minLength": 1},
        "catchment_m": {"type": "integer", "minimum": 1},
        "note": {"type": "string"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "lines", "walk_links"],
          "properties": {
            "nodes": {"type": "integer", "minimum": 1},
            "lines": {"type": "integer", "minimum": 1},
            "walk_links": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_zh", "name_en", "kind", "lat", "lng", "lines", "accessible", "provenance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name_zh": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "kind": {"enum": ["mtr_station", "bus_stop", "pier"]},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lng": {"type": "number", "minimum": -180, "maximum": 180},
          "lines": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "accessible": {"enum": [true, false, "partial", null]},
          "accessibility_status": {"type": "string", "minLength": 1},
          "provenance": {"enum": ["real", "real-derived", "simulated"]},
          "catchment_m": {"type": "integer", "minimum": 1},
          "coordinate_source": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_zh", "name_en", "mode", "bidirectional", "stops", "seg_time_s", "headway_s", "capacity_per_vehicle", "accessible", "provenance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name_zh": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "mode": {"enum": ["MTR", "BUS", "FERRY"]},
          "bidirectional": {"type": "boolean"},
          "stops": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "seg_time_s": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
          "headway_s": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weekday_peak", "weekday_offpeak", "saturday", "sunday_ph"],
            "properties": {
              "weekday_peak": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "weekday_offpeak": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "saturday": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "sunday_ph": {"type": ["number", "null"], "exclusiveMinimum": 0}
            }
          },
          "capacity_per_vehicle": {"type": "number", "exclusiveMinimum": 0},
          "capacity_note": {"type": "string"},
          "accessible": {"enum": [true, false, "partial", null]},
          "fare_baseline": {"type": "boolean"},
          "fare_hkd": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
          "provenance": {"enum": ["real", "real-derived", "simulated"]},
          "scope_note": {"type": "string"},
          "collapsed_stops_note": {"type": "string"},
          "headway_status": {"type": "string", "minLength": 1},
          "tunnel": {"type": ["string", "null"]},
          "operator": {"type": "string", "minLength": 1},
          "service_hours": {"type": "string", "minLength": 1},
          "service_hours_reverse": {"type": "string", "minLength": 1},
          "service_calendar": {"type": "string", "minLength": 1},
          "weather_sensitive": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "walk_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "walk_s", "walk_m", "accessible", "provenance"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "walk_s": {"type": "number", "exclusiveMinimum": 0},
          "walk_m": {"type": "number", "minimum": 0},
          "accessible": {"enum": [true, false, "partial", null]},
          "provenance": {"enum": ["real", "real-derived", "simulated"]},
          "note": {"type": "string"}
        }
      }
    },
    "missing_nodes_note": {"type": "string"}
  }
}
