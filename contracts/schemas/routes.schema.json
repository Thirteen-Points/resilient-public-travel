{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilient-public-travel.local/contracts/routes.schema.json",
  "title": "ResilientRoute route seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "routes", "persona_top_picks", "excluded_route_examples"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "built_at", "scenario", "od", "purpose", "candidate_count_target", "included_here", "diversity_note", "provenance"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "built_at": {"type": "string", "format": "date"},
        "scenario": {"type": "string", "minLength": 1},
        "od": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "destination", "depart_at", "service_day"],
          "properties": {
            "origin": {"type": "string", "minLength": 1},
            "destination": {"type": "string", "minLength": 1},
            "depart_at": {"type": "string", "format": "date-time"},
            "service_day": {"enum": ["weekday", "saturday", "sunday_ph"]}
          }
        },
        "purpose": {"type": "string", "minLength": 1},
        "candidate_count_target": {"type": "integer", "minimum": 1},
        "included_here": {"type": "integer", "minimum": 0},
        "diversity_note": {"type": "string"},
        "provenance": {"enum": ["real", "real-derived", "simulated"]}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "label", "legs", "total", "score", "score_breakdown", "load_estimate", "warnings", "notes", "explain", "evidence", "provenance"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "legs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "from", "to", "depart", "arrive", "in_vehicle_s", "walk_m", "fare_hkd", "accessible", "provenance", "evidence"],
              "properties": {
                "mode": {"enum": ["MTR", "BUS", "MINIBUS", "WALK", "FERRY"]},
                "from": {"type": "string", "minLength": 1},
                "to": {"type": "string", "minLength": 1},
                "depart": {"type": "string", "format": "date-time"},
                "arrive": {"type": "string", "format": "date-time"},
                "headway_s": {"type": "number", "exclusiveMinimum": 0},
                "in_vehicle_s": {"type": "number", "minimum": 0},
                "walk_m": {"type": "number", "minimum": 0},
                "fare_hkd": {"type": "number", "minimum": 0},
                "accessible": {"type": "boolean"},
                "provenance": {"enum": ["real", "real-derived", "simulated"]},
                "line": {"type": "string", "minLength": 1},
                "evidence": {"$ref": "#/$defs/evidenceArray"}
              }
            }
          },
          "total": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time_s", "time_range_s", "transfers", "walk_m", "fare_hkd", "co2_g", "reliability", "freshness_s"],
            "properties": {
              "time_s": {"type": "number", "minimum": 0},
              "time_range_s": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}], "minItems": 2, "maxItems": 2},
              "transfers": {"type": "integer", "minimum": 0},
              "walk_m": {"type": "number", "minimum": 0},
              "fare_hkd": {"type": "number", "minimum": 0},
              "co2_g": {"type": "number", "minimum": 0},
              "reliability": {"type": "number", "minimum": 0, "maximum": 1},
              "freshness_s": {"type": "number", "minimum": 0}
            }
          },
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "score_breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "raw", "normalized", "weight", "contribution"],
              "properties": {
                "criterion": {"type": "string", "minLength": 1},
                "raw": {"type": "number"},
                "normalized": {"type": "number", "minimum": 0, "maximum": 1},
                "weight": {"type": "number", "minimum": 0, "maximum": 1},
                "contribution": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "load_estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected_wait_s", "load_factor", "users_on_route", "capacity_per_hour", "board_refusal_prob"],
            "properties": {
              "expected_wait_s": {"type": "number", "minimum": 0},
              "load_factor": {"type": "number", "minimum": 0},
              "users_on_route": {"type": "integer", "minimum": 0},
              "capacity_per_hour": {"type": "number", "minimum": 0},
              "board_refusal_prob": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "warnings": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}},
          "explain": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidenceArray"},
          "provenance": {"enum": ["real", "real-derived", "simulated"]}
        }
      }
    },
    "persona_top_picks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "persona", "preset", "urgency", "top", "headline", "reason", "mobility"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "persona": {"enum": ["commuter", "student", "tourist", "elderly", "wheelchair"]},
          "preset": {"enum": ["fastest", "most_stable", "fewest_transfers"]},
          "urgency": {"enum": ["high", "normal", "low"]},
          "top": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "headline": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "hard_filters_applied": {"type": "array", "items": {"type": "string"}},
          "mobility": {"enum": ["standard", "reduced", "wheelchair"]},
          "max_walk_m": {"type": "number", "minimum": 0},
          "max_transfers": {"type": "integer", "minimum": 0},
          "walking_speed_mps": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "excluded_route_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "reason"],
        "properties": {
          "route": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "evidenceArray": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "fields": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "used": {"type": "boolean"},
          "freshness_s": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
