# LLM is optional. AI_ENABLED enables environment keys; the admin can separately
# enable saved keys. OFFLINE_MODE/AI_DISABLE_EXTERNAL override both paths.
HOST=127.0.0.1
PORT=8000
AI_ENABLED=false
OFFLINE_MODE=true
# Relative to the repository root; these seeds are simulated and local-only.
SEED_NETWORK=contracts/seed/network.seed.json
SEED_EVENTS=contracts/seed/event.seed.json
# Optional deep-health smoke OD; defaults to the standard demo OD.
DEEP_HEALTH_ORIGIN=TAW
DEEP_HEALTH_DESTINATION=ADM
DEEP_HEALTH_DEPART_AT=2026-09-22T08:20:00+08:00
# Six core nodes produce 30 directed OD smoke checks.
SMOKE_OD_NODES=TAW,KOT,MKK,HUH,EXC,ADM
SMOKE_DEPART_AT=2026-09-22T08:20:00+08:00
AI_TIMEOUT_S=10
AI_BUDGET_CNY=50
AI_CACHE_TTL_S=900
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_DISABLE_EXTERNAL=false
AI_MAX_OUTPUT_TOKENS=2048
AI_UNKNOWN_REQUEST_RESERVE_CNY=1
DEEPSEEK_INPUT_COST_PER_MILLION=2
DEEPSEEK_CACHE_HIT_COST_PER_MILLION=0.04
DEEPSEEK_OUTPUT_COST_PER_MILLION=8
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-flash

# Independent-process online collector; never starts in FastAPI workers.
# Use the SAME absolute DB_PATH for the backend and collector.
# DB_PATH=C:/path/to/resilient-public-travel/backend/app/data/events.sqlite3
INGEST_ENABLED=false
INGEST_SOURCES=mtr_mobile
INGEST_INTERVAL_SECONDS=300
INGEST_LOOKBACK_HOURS=24
INGEST_MAX_ITEMS=100
INGEST_PAGE_SIZE=25
INGEST_TIMEOUT_SECONDS=10
INGEST_RETRIES=2
INGEST_MTR_LANG=zh-HK
INGEST_EXTRA_KEYWORDS=
# Empty placeholders: v1 reports these platforms as blocked, even if set.
# Future adapters require verified official permissions and live acceptance.
THREADS_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
INGEST_AUTHOR_SALT=
